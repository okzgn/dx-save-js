{
  "name": "dx-save",
  "version": "2.0.0",
  "description": "An agnostic, asynchronous, and reactive data persistence engine for JavaScript/TypeScript. Designed to seamlessly handle auto-saving, optimistic UI, debouncing, and error recovery without triggering infinite reactive loops.",
  "type": "module",
  "main": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "keywords": [
    "DX",
    "Developer",
    "Experience",
    "Lightweight",
    "Zero-dependency",
    "Dependency-free"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "sideEffects": true,
  "license": "MIT",
  "author": "OKZGN",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okzgn/dx-save-js.git"
  },
